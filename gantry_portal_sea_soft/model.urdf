<?xml version="1.0"?>
<robot name="gantry_portal_sea_soft_portal_rigid">

  <!-- World anchor -->
  <link name="world"/>

  <joint name="world_to_chassis" type="fixed">
    <parent link="world"/>
    <child link="chassis"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
  </joint>

  <!-- Chassis (just a base link for the portal) -->
  <link name="chassis">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.01" ixy="0" ixz="0"
               iyy="0.01" iyz="0"
               izz="0.01"/>
    </inertial>
  </link>

  <!-- Legs (each leg link frame at leg base; geometry centered at z=+1 for 2m height) -->
  
  <link name="leg1">
    <inertial>
      <origin xyz="0 0 1" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.334167" ixy="0" ixz="0"
               iyy="0.334167" iyz="0"
               izz="0.001667"/>
    </inertial>
    <visual>
      <origin xyz="0 0 1" rpy="0 0 0"/>
      <geometry><box size="0.1 0.1 2.0"/></geometry>
      <material name="portal"><color rgba="0.2 0.2 0.2 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 1" rpy="0 0 0"/>
      <geometry><box size="0.1 0.1 2.0"/></geometry>
    </collision>
  </link>

  <joint name="chassis_to_leg1" type="fixed">
    <parent link="chassis"/>
    <child link="leg1"/>
    <origin xyz="-1 -1 0" rpy="0 0 0"/>
  </joint>
  
  <link name="leg2">
    <inertial>
      <origin xyz="0 0 1" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.334167" ixy="0" ixz="0"
               iyy="0.334167" iyz="0"
               izz="0.001667"/>
    </inertial>
    <visual>
      <origin xyz="0 0 1" rpy="0 0 0"/>
      <geometry><box size="0.1 0.1 2.0"/></geometry>
      <material name="portal"><color rgba="0.2 0.2 0.2 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 1" rpy="0 0 0"/>
      <geometry><box size="0.1 0.1 2.0"/></geometry>
    </collision>
  </link>

  <joint name="chassis_to_leg2" type="fixed">
    <parent link="chassis"/>
    <child link="leg2"/>
    <origin xyz="1 -1 0" rpy="0 0 0"/>
  </joint>
  
  <link name="leg3">
    <inertial>
      <origin xyz="0 0 1" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.334167" ixy="0" ixz="0"
               iyy="0.334167" iyz="0"
               izz="0.001667"/>
    </inertial>
    <visual>
      <origin xyz="0 0 1" rpy="0 0 0"/>
      <geometry><box size="0.1 0.1 2.0"/></geometry>
      <material name="portal"><color rgba="0.2 0.2 0.2 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 1" rpy="0 0 0"/>
      <geometry><box size="0.1 0.1 2.0"/></geometry>
    </collision>
  </link>

  <joint name="chassis_to_leg3" type="fixed">
    <parent link="chassis"/>
    <child link="leg3"/>
    <origin xyz="-1 1 0" rpy="0 0 0"/>
  </joint>
  
  <link name="leg4">
    <inertial>
      <origin xyz="0 0 1" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.334167" ixy="0" ixz="0"
               iyy="0.334167" iyz="0"
               izz="0.001667"/>
    </inertial>
    <visual>
      <origin xyz="0 0 1" rpy="0 0 0"/>
      <geometry><box size="0.1 0.1 2.0"/></geometry>
      <material name="portal"><color rgba="0.2 0.2 0.2 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 1" rpy="0 0 0"/>
      <geometry><box size="0.1 0.1 2.0"/></geometry>
    </collision>
  </link>

  <joint name="chassis_to_leg4" type="fixed">
    <parent link="chassis"/>
    <child link="leg4"/>
    <origin xyz="1 1 0" rpy="0 0 0"/>
  </joint>
  

  <!-- Top beams (frames located at left end x=-1; geometry centered at x=+1 for 2m length) -->
  <link name="beam1">
    <inertial>
      <origin xyz="1 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.001667" ixy="0" ixz="0"
               iyy="0.334167" iyz="0"
               izz="0.334167"/>
    </inertial>
    <visual>
      <origin xyz="1 0 0" rpy="0 0 0"/>
      <geometry><box size="2.0 0.1 0.1"/></geometry>
      <material name="portal"><color rgba="0.2 0.2 0.2 1"/></material>
    </visual>
    <collision>
      <origin xyz="1 0 0" rpy="0 0 0"/>
      <geometry><box size="2.0 0.1 0.1"/></geometry>
    </collision>
  </link>

  <link name="beam2">
    <inertial>
      <origin xyz="1 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.001667" ixy="0" ixz="0"
               iyy="0.334167" iyz="0"
               izz="0.334167"/>
    </inertial>
    <visual>
      <origin xyz="1 0 0" rpy="0 0 0"/>
      <geometry><box size="2.0 0.1 0.1"/></geometry>
      <material name="portal"><color rgba="0.2 0.2 0.2 1"/></material>
    </visual>
    <collision>
      <origin xyz="1 0 0" rpy="0 0 0"/>
      <geometry><box size="2.0 0.1 0.1"/></geometry>
    </collision>
  </link>

  <joint name="leg1_to_beam1" type="fixed">
    <parent link="leg1"/>
    <child link="beam1"/>
    <origin xyz="0 0 2" rpy="0 0 0"/>
  </joint>

  <joint name="leg3_to_beam2" type="fixed">
    <parent link="leg3"/>
    <child link="beam2"/>
    <origin xyz="0 0 2" rpy="0 0 0"/>
  </joint>

  <!-- X carriage on beam1 -->
  <link name="cursor_1">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.000866667" ixy="0" ixz="0"
               iyy="0.000866667" iyz="0"
               izz="0.0012"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.12 0.12 0.08"/></geometry>
      <material name="cursor"><color rgba="0.2 0.5 0.9 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.12 0.12 0.08"/></geometry>
    </collision>
  </link>

  <joint name="joint_1" type="prismatic">
    <parent link="beam1"/>
    <child link="cursor_1"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="0.0" upper="2.0"
           effort="300.0" velocity="1.0"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint>

  <!-- beam3 (2m along +y), rigidly attached to cursor_1 -->
  <link name="beam3">
    <inertial>
      <origin xyz="0 1 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.334167" ixy="0" ixz="0"
               iyy="0.001667" iyz="0"
               izz="0.334167"/>
    </inertial>
    <visual>
      <origin xyz="0 1 0" rpy="0 0 0"/>
      <geometry><box size="0.1 2.0 0.1"/></geometry>
      <material name="beam"><color rgba="0.8 0.8 0.8 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 1 0" rpy="0 0 0"/>
      <geometry><box size="0.1 2.0 0.1"/></geometry>
    </collision>
  </link>

  <joint name="cursor_1_to_beam3" type="fixed">
    <parent link="cursor_1"/>
    <child link="beam3"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Y carriage on beam3 -->
  <link name="cursor_2">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.000866667" ixy="0" ixz="0"
               iyy="0.000866667" iyz="0"
               izz="0.0012"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.12 0.12 0.08"/></geometry>
      <material name="cursor"><color rgba="0.2 0.5 0.9 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.12 0.12 0.08"/></geometry>
    </collision>
  </link>

  <joint name="joint_2" type="prismatic">
    <parent link="beam3"/>
    <child link="cursor_2"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0.0" upper="2.0"
           effort="300.0" velocity="1.0"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint>

  <!-- Vertical beam4: link frame at its lower end; geometry centered at z=+1 (2m tall) -->
  <link name="beam4">
    <inertial>
      <origin xyz="0 0 1" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.334167" ixy="0" ixz="0"
               iyy="0.334167" iyz="0"
               izz="0.001667"/>
    </inertial>
    <visual>
      <origin xyz="0 0 1" rpy="0 0 0"/>
      <geometry><box size="0.1 0.1 2.0"/></geometry>
      <material name="beam"><color rgba="0.8 0.8 0.8 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 1" rpy="0 0 0"/>
      <geometry><box size="0.1 0.1 2.0"/></geometry>
    </collision>
  </link>

  <joint name="joint_3" type="prismatic">
    <parent link="cursor_2"/>
    <child link="beam4"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.0" upper="0.0"
           effort="300.0" velocity="1.0"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint>

  <!-- End-effector as a box at the lower end of beam4 -->
  <link name="ee_link">
    <inertial>
      <origin xyz="0 0 -0.05" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0.000333333" ixy="0" ixz="0"
               iyy="0.000333333" iyz="0"
               izz="0.000333333"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.05" rpy="0 0 0"/>
      <geometry><box size="0.1 0.1 0.1"/></geometry>
      <material name="ee"><color rgba="0.9 0.3 0.3 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 -0.05" rpy="0 0 0"/>
      <geometry><box size="0.1 0.1 0.1"/></geometry>
    </collision>
  </link>

  <joint name="beam4_to_ee" type="fixed">
    <parent link="beam4"/>
    <child link="ee_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

</robot>